{
  "name": "jayos-recorder",
  "version": "0.1.0",
  "description": "Screen recording app with webcam picture-in-picture overlay",
  "main": "out/main/index.js",
  "author": "bunkheangheng99@gmail.com",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "install:mac": "electron-vite build && electron-builder --mac dir && rm -rf ~/Desktop/'JAYOS Recorder.app' && cp -R './dist/mac-arm64/JAYOS Recorder.app' ~/Desktop/"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.jayos.recorder",
    "productName": "JAYOS Recorder",
    "files": ["out/**/*"],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
