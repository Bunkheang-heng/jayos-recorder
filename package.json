{
  "name": "jayos-recorder",
  "version": "0.1.0",
  "description": "Cross-platform screen recorder with webcam overlay (macOS, Windows, Linux)",
  "main": "out/main/index.js",
  "author": "bunkheangheng99@gmail.com",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check:signing": "node scripts/check-signing.mjs",
    "check:signing:mac": "node scripts/check-signing.mjs mac",
    "check:signing:win": "node scripts/check-signing.mjs win",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:mac:signed": "node scripts/check-signing.mjs mac && electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "package:win:signed": "node scripts/check-signing.mjs win && electron-vite build && electron-builder --win",
    "package:linux": "electron-vite build && electron-builder --linux",
    "install:mac": "electron-vite build && electron-builder --mac dir && rm -rf ~/Desktop/'JAYOS Recorder.app' && cp -R './dist/mac-arm64/JAYOS Recorder.app' ~/Desktop/"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.jayos.recorder",
    "productName": "JAYOS Recorder",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "extendInfo": {
        "NSCameraUsageDescription": "JAYOS needs camera access for the webcam overlay.",
        "NSMicrophoneUsageDescription": "JAYOS needs microphone access to record narration.",
        "NSScreenCaptureUsageDescription": "JAYOS needs Screen Recording access to capture displays and windows."
      }
    },
    "dmg": {
      "sign": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signingHashAlgorithms": [
        "sha256"
      ],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
