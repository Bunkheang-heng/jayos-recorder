# Copy to signing.env (gitignored) and fill in real values.
#   cp build/signing.env.example signing.env
#   set -a && source ./signing.env && set +a
#   npm run package:mac:signed
#   npm run package:win:signed

# ── macOS (Apple Developer Program, $99/yr) ──────────────────────────
# 1) Create "Developer ID Application" cert in developer.apple.com
# 2) Install it in Keychain (electron-builder picks it up automatically)
# 3) Create App Store Connect API key (.p8) — recommended notarization path:

APPLE_API_KEY=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=XXXXXXXXXX
APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: force a specific signing identity
# CSC_NAME=Developer ID Application: Your Name (TEAMID)

# Alternate notarization (instead of API key):
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=TEAMID1234

# ── Windows (Authenticode certificate from DigiCert/Sectigo/SSL.com) ─
# EV certs clear SmartScreen fastest; OV works after reputation builds.

WIN_CSC_LINK=/absolute/path/to/codesign.pfx
WIN_CSC_KEY_PASSWORD=your-pfx-password

# Or use the Windows certificate store:
# WIN_CSC_NAME=Your Company Name
